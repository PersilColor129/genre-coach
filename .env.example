# Copy to .env.local for local development (.env.local is not committed).
# On Vercel, set the same variables under Project → Settings → Environment Variables.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=sb_publishable_...

# "production" ONLY for the Vercel Production environment.
# Leave it out (or set "test") everywhere else: scores then go to the separate "<game>-test" leaderboard.
VITE_LEADERBOARD_ENV=test
